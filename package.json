{
  "name": "nubisco",
  "displayName": "Nubisco",
  "description": "Small everyday developer tools for VS Code: a Cloudflare Access tunnel switcher and Wake-on-LAN for your machines",
  "version": "1.1.0",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "publisher": "nubisco",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nubisco/vscode-nubisco.git"
  },
  "homepage": "https://github.com/nubisco/vscode-nubisco#readme",
  "bugs": {
    "url": "https://github.com/nubisco/vscode-nubisco/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/joseporto"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cloudflare",
    "cloudflared",
    "tunnel",
    "zero trust",
    "ssh",
    "access",
    "wake-on-lan",
    "wol"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nubisco",
          "title": "Nubisco",
          "icon": "media/nubisco.svg"
        }
      ]
    },
    "views": {
      "nubisco": [
        {
          "id": "nubisco.tunnels",
          "name": "Tunnels",
          "icon": "media/nubisco.svg"
        },
        {
          "id": "nubisco.machines",
          "name": "Machines",
          "icon": "media/nubisco.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nubisco.tunnels.refresh",
        "title": "Refresh Tunnels",
        "category": "Nubisco",
        "icon": "$(refresh)"
      },
      {
        "command": "nubisco.tunnels.pick",
        "title": "Toggle Tunnel…",
        "category": "Nubisco",
        "icon": "$(plug)"
      },
      {
        "command": "nubisco.tunnels.start",
        "title": "Start Tunnel",
        "category": "Nubisco",
        "icon": "$(debug-start)"
      },
      {
        "command": "nubisco.tunnels.stop",
        "title": "Stop Tunnel",
        "category": "Nubisco",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nubisco.tunnels.copy",
        "title": "Copy to Clipboard",
        "category": "Nubisco",
        "icon": "$(copy)"
      },
      {
        "command": "nubisco.tunnels.add",
        "title": "Add Tunnel…",
        "category": "Nubisco",
        "icon": "$(add)"
      },
      {
        "command": "nubisco.tunnels.edit",
        "title": "Edit Tunnel…",
        "category": "Nubisco",
        "icon": "$(edit)"
      },
      {
        "command": "nubisco.tunnels.remove",
        "title": "Remove Tunnel",
        "category": "Nubisco",
        "icon": "$(trash)"
      },
      {
        "command": "nubisco.tunnels.openSettings",
        "title": "Open Tunnel Settings",
        "category": "Nubisco",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nubisco.wake.wake",
        "title": "Wake Machine",
        "category": "Nubisco",
        "icon": "$(zap)"
      },
      {
        "command": "nubisco.wake.pick",
        "title": "Wake Machine…",
        "category": "Nubisco",
        "icon": "$(zap)"
      },
      {
        "command": "nubisco.wake.add",
        "title": "Add Machine…",
        "category": "Nubisco",
        "icon": "$(add)"
      },
      {
        "command": "nubisco.wake.edit",
        "title": "Edit Machine…",
        "category": "Nubisco",
        "icon": "$(edit)"
      },
      {
        "command": "nubisco.wake.remove",
        "title": "Remove Machine",
        "category": "Nubisco",
        "icon": "$(trash)"
      },
      {
        "command": "nubisco.wake.openSettings",
        "title": "Open Machine Settings",
        "category": "Nubisco",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nubisco.tunnels.add",
          "when": "view == nubisco.tunnels",
          "group": "navigation@1"
        },
        {
          "command": "nubisco.tunnels.pick",
          "when": "view == nubisco.tunnels",
          "group": "navigation@2"
        },
        {
          "command": "nubisco.tunnels.refresh",
          "when": "view == nubisco.tunnels",
          "group": "navigation@3"
        },
        {
          "command": "nubisco.tunnels.openSettings",
          "when": "view == nubisco.tunnels",
          "group": "settings@1"
        },
        {
          "command": "nubisco.wake.add",
          "when": "view == nubisco.machines",
          "group": "navigation@1"
        },
        {
          "command": "nubisco.wake.pick",
          "when": "view == nubisco.machines",
          "group": "navigation@2"
        },
        {
          "command": "nubisco.wake.openSettings",
          "when": "view == nubisco.machines",
          "group": "settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "nubisco.tunnels.start",
          "when": "view == nubisco.tunnels && viewItem == tunnel.stopped",
          "group": "inline"
        },
        {
          "command": "nubisco.tunnels.stop",
          "when": "view == nubisco.tunnels && viewItem == tunnel.running",
          "group": "inline"
        },
        {
          "command": "nubisco.tunnels.copy",
          "when": "view == nubisco.tunnels && viewItem == tunnel.instruction",
          "group": "inline"
        },
        {
          "command": "nubisco.tunnels.edit",
          "when": "view == nubisco.tunnels && viewItem =~ /^tunnel\\.(running|stopped|busy)$/",
          "group": "1_modify@1"
        },
        {
          "command": "nubisco.tunnels.remove",
          "when": "view == nubisco.tunnels && viewItem =~ /^tunnel\\.(running|stopped|busy)$/",
          "group": "1_modify@2"
        },
        {
          "command": "nubisco.wake.wake",
          "when": "view == nubisco.machines && viewItem == machine.idle",
          "group": "inline"
        },
        {
          "command": "nubisco.wake.edit",
          "when": "view == nubisco.machines && viewItem =~ /^machine\\./",
          "group": "1_modify@1"
        },
        {
          "command": "nubisco.wake.remove",
          "when": "view == nubisco.machines && viewItem =~ /^machine\\./",
          "group": "1_modify@2"
        }
      ],
      "commandPalette": [
        {
          "command": "nubisco.tunnels.start",
          "when": "false"
        },
        {
          "command": "nubisco.tunnels.stop",
          "when": "false"
        },
        {
          "command": "nubisco.tunnels.copy",
          "when": "false"
        },
        {
          "command": "nubisco.tunnels.edit",
          "when": "false"
        },
        {
          "command": "nubisco.tunnels.remove",
          "when": "false"
        },
        {
          "command": "nubisco.wake.wake",
          "when": "false"
        },
        {
          "command": "nubisco.wake.edit",
          "when": "false"
        },
        {
          "command": "nubisco.wake.remove",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Nubisco",
      "properties": {
        "nubisco.tunnels.cloudflaredPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `cloudflared` binary. Leave empty to auto-detect (Homebrew locations, then `PATH`).",
          "scope": "machine"
        },
        "nubisco.tunnels.pollInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "How often (in milliseconds) to check which tunnels are listening.",
          "scope": "application"
        },
        "nubisco.tunnels.definitions": {
          "type": "array",
          "default": [],
          "markdownDescription": "Tunnels shown in the Nubisco Tunnels view. Each one runs `cloudflared access tcp --hostname <host> --url localhost:<port>`. Use **Add Tunnel** in the view, or edit this list directly.",
          "items": {
            "type": "object",
            "required": [
              "host",
              "port"
            ],
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "description": "Cloudflare Access hostname of the TCP application, e.g. ssh.example.com."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Local port to listen on. Must be unique across tunnels."
              },
              "label": {
                "type": "string",
                "description": "Display name. Defaults to the hostname."
              },
              "instructions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "How to connect once the tunnel is up; each entry can be clicked to copy."
              }
            }
          },
          "scope": "application",
          "examples": [
            [
              {
                "host": "ssh.example.com",
                "port": 2222,
                "label": "Home server · SSH",
                "instructions": [
                  "ssh -p 2222 me@localhost"
                ]
              }
            ]
          ]
        },
        "nubisco.wake.machines": {
          "type": "array",
          "default": [],
          "markdownDescription": "Machines shown in the Nubisco Machines view, woken with a Wake-on-LAN magic packet. On the machine's network the packet is broadcast from here. Elsewhere it is sent by `relay` over SSH (which needs `python3` there). When `ssh` and `afterWake` are set, the command runs on the machine once it answers, retrying up to three times.",
          "items": {
            "type": "object",
            "required": [
              "mac"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Display name. Defaults to the MAC address."
              },
              "mac": {
                "type": "string",
                "description": "MAC address of the network card that listens for Wake-on-LAN, e.g. aa:bb:cc:dd:ee:ff."
              },
              "address": {
                "type": "string",
                "description": "The machine's IPv4 address. Used to tell whether you are on its network."
              },
              "broadcast": {
                "type": "string",
                "description": "Directed broadcast address of the machine's network, e.g. 192.168.1.255. Needed by the relay when its network has several interfaces."
              },
              "relay": {
                "type": "string",
                "markdownDescription": "SSH destination on the machine's network (an alias from `~/.ssh/config` works) that sends the packet when you are on another network. Requires `address` or `broadcast`."
              },
              "ssh": {
                "type": "string",
                "markdownDescription": "SSH destination of the machine itself, e.g. `me@192.168.1.20`. Reached through `relay` when you are on another network. Needs key-based login."
              },
              "afterWake": {
                "type": "string",
                "markdownDescription": "Command run on the machine over `ssh` once it answers. On a Mac, `caffeinate -u -t 5` turns the short dark wake a magic packet gives into a full wake."
              }
            }
          },
          "scope": "application",
          "examples": [
            [
              {
                "label": "Office desktop",
                "mac": "aa:bb:cc:dd:ee:ff",
                "address": "192.168.1.20",
                "relay": "gateway-remote",
                "ssh": "me@192.168.1.20",
                "afterWake": "caffeinate -u -t 5"
              }
            ]
          ]
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "nubisco.tunnels",
        "contents": "No tunnels yet. A tunnel opens a local port to a Cloudflare Access TCP application using `cloudflared access tcp`.\n[Add Tunnel](command:nubisco.tunnels.add)\nYou can also define tunnels in [settings](command:nubisco.tunnels.openSettings)."
      },
      {
        "view": "nubisco.machines",
        "contents": "No machines yet. Wake a sleeping machine with a Wake-on-LAN magic packet, from its network or through an SSH relay.\n[Add Machine](command:nubisco.wake.add)\nYou can also define machines in [settings](command:nubisco.wake.openSettings)."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node build.js",
    "watch": "node build.js --watch",
    "package": "vsce package -o nubisco.vsix",
    "install:local": "pnpm run package && code --install-extension nubisco.vsix --force",
    "types:check": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^20",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "latest",
    "esbuild": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "semantic-release": "^25.0.9",
    "semantic-release-vsce": "^6.1.8",
    "typescript": "^6",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "vsce": {
    "dependencies": false
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "semantic-release-vsce",
        {
          "packageVsix": "nubisco.vsix"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "nubisco.vsix",
              "label": "nubisco.vsix"
            }
          ]
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  }
}
